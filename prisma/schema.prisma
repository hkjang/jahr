// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgLevel {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
}

enum EmploymentType {
  REGULAR
  CONTRACT
  INTERN
  PART_TIME
}

enum WorkType {
  OFFICE
  REMOTE
  HYBRID
  FLEXIBLE
}

enum Degree {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
}

enum FamilyRelation {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum DocumentType {
  CONTRACT
  CERTIFICATE
  ID_CARD
  RESUME
  OTHER
}

enum AppointmentType {
  HIRE
  PROMOTION
  TRANSFER
  DEMOTION
  RESIGNATION
  RETIREMENT
  LEAVE_OF_ABSENCE
  RETURN_FROM_LEAVE
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  ABSENT
  HOLIDAY
  LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  OFFICIAL
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LineStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalDocType {
  LEAVE_REQUEST
  APPOINTMENT
  EXPENSE
  OVERTIME
  BUSINESS_TRIP
  OTHER
}

enum SalaryItemType {
  EARNING
  DEDUCTION
}

enum EvaluationType {
  HALF_YEARLY
  YEARLY
}

enum PeriodStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum EvaluationStatus {
  NOT_STARTED
  SELF_EVALUATION
  MANAGER_EVALUATION
  COMPLETED
}

enum EvaluationGrade {
  S
  A
  B
  C
  D
}

enum CourseType {
  INTERNAL
  EXTERNAL
  ONLINE
  OFFLINE
}

enum TrainingStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String     @id @default(cuid())
  employeeId    String     @unique // 사번
  email         String     @unique
  password      String
  name          String
  phoneNumber   String?
  birthDate     DateTime?
  profileImage  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  employee            Employee?
  roles               UserRole[]
  auditLogs           AuditLog[]
  sessions            Session[]
  approvalRequests    Approval[]     @relation("ApprovalRequester")
  approvalLines       ApprovalLine[] @relation("ApprovalApprover")
  notifications       Notification[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  module   String
  action   String
  scope    String   @default("self")
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

// ============================================
// ORGANIZATION
// ============================================

model Organization {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  level       OrgLevel
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  parentId    String?
  parent      Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgHierarchy")
  employees   Employee[]
  workforcePlans WorkforcePlan[]
  headcountLimits HeadcountLimit[]
  laborCostForecasts LaborCostForecast[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentId])
  @@index([code])
}

model Position {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  level       Int        // 숫자가 낮을수록 높은 직급
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([level])
}

model JobTitle {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String     // 과장, 부장, 팀장 등 직책
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Job {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  competencies JobCompetency[]
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ============================================
// EMPLOYEE
// ============================================

model Employee {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])

  positionId      String
  position        Position       @relation(fields: [positionId], references: [id])

  jobTitleId      String?
  jobTitle        JobTitle?      @relation(fields: [jobTitleId], references: [id])

  jobId           String?
  job             Job?           @relation(fields: [jobId], references: [id])

  hireDate        DateTime
  employmentType  EmploymentType @default(REGULAR)
  workType        WorkType       @default(OFFICE)

  // 겸직 관리
  additionalOrgs  EmployeeOrganization[]

  educations      Education[]
  careers         Career[]
  families        Family[]
  documents       Document[]
  appointments    Appointment[]
  attendances     Attendance[]
  leaves          Leave[]
  leaveBalances   LeaveBalance[]
  salaries        Salary[]
  evaluations     Evaluation[]
  trainings       Training[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([positionId])
  @@index([hireDate])
}

// 겸직 관리
model EmployeeOrganization {
  id              String       @id @default(cuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId  String
  startDate       DateTime
  endDate         DateTime?
  isPrimary       Boolean      @default(false)

  @@unique([employeeId, organizationId])
}

model Education {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schoolName   String
  major        String?
  degree       Degree
  startDate    DateTime
  endDate      DateTime?
  graduated    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
}

model Career {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyName String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

model Family {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  relation    FamilyRelation
  name        String
  birthDate   DateTime?
  contact     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
}

model Document {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String?
  uploadedAt  DateTime     @default(now())

  @@index([employeeId])
  @@index([type])
}

model Appointment {
  id               String          @id @default(cuid())
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             AppointmentType
  effectiveDate    DateTime
  previousOrgId    String?
  newOrgId         String?
  previousPositionId String?
  newPositionId    String?
  reason           String?
  approvalId       String?
  approval         Approval?       @relation(fields: [approvalId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
  @@index([type])
}

// ============================================
// ATTENDANCE & LEAVE
// ============================================

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  workType    WorkType         @default(OFFICE)
  status      AttendanceStatus @default(NORMAL)
  workMinutes Int?             // 실 근무시간 (분)
  overtimeMinutes Int?         // 초과근무시간 (분)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Leave {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Float          // 0.5 = 반차
  reason      String?
  status      ApprovalStatus @default(PENDING)
  approvalId  String?
  approval    Approval?      @relation(fields: [approvalId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int
  leaveType   LeaveType @default(ANNUAL)
  totalDays   Float
  usedDays    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
}

// ============================================
// SALARY
// ============================================

model Salary {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  yearMonth     String   // YYYYMM
  baseSalary    Decimal  @db.Decimal(15, 2)
  bonus         Decimal  @default(0) @db.Decimal(15, 2)
  allowances    Json     // 수당 상세 { "식대": 100000, "교통비": 50000 }
  deductions    Json     // 공제 상세 { "소득세": 50000, "국민연금": 40000 }
  totalEarnings Decimal  @db.Decimal(15, 2)
  totalDeductions Decimal @db.Decimal(15, 2)
  netSalary     Decimal  @db.Decimal(15, 2)
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, yearMonth])
  @@index([employeeId])
  @@index([yearMonth])
}

model SalaryItem {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  type     SalaryItemType
  formula  String?        // 계산 공식
  isActive Boolean        @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ============================================
// EVALUATION
// ============================================

model EvaluationPeriod {
  id          String       @id @default(cuid())
  name        String
  year        Int
  type        EvaluationType
  startDate   DateTime
  endDate     DateTime
  status      PeriodStatus @default(DRAFT)
  evaluations Evaluation[]
  templates   EvaluationTemplate[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([year, type])
}

model EvaluationTemplate {
  id          String           @id @default(cuid())
  periodId    String
  period      EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String
  items       EvaluationTemplateItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EvaluationTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String
  name        String
  description String?
  weight      Float              // 가중치 (%)
  maxScore    Float              @default(5)
  sortOrder   Int                @default(0)
}

model Evaluation {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodId     String
  period       EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  selfScore    Decimal?         @db.Decimal(5, 2)
  managerScore Decimal?         @db.Decimal(5, 2)
  finalScore   Decimal?         @db.Decimal(5, 2)
  grade        EvaluationGrade?
  status       EvaluationStatus @default(NOT_STARTED)
  selfComment  String?
  managerComment String?
  items        EvaluationItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, periodId])
  @@index([employeeId])
  @@index([periodId])
}

model EvaluationItem {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  category     String
  name         String
  weight       Float
  selfScore    Decimal?   @db.Decimal(5, 2)
  managerScore Decimal?   @db.Decimal(5, 2)
  selfComment  String?
  managerComment String?
}

// ============================================
// TRAINING
// ============================================

model Course {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  type         CourseType
  description  String?
  instructor   String?
  duration     Int          // 시간
  maxCapacity  Int?
  competencies CourseCompetency[]
  isActive     Boolean      @default(true)
  trainings    Training[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Training {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  status      TrainingStatus @default(ENROLLED)
  score       Decimal?       @db.Decimal(5, 2)
  certificate String?
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
  @@index([courseId])
}

// 역량 관리
model Competency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  jobs        JobCompetency[]
  courses     CourseCompetency[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobCompetency {
  jobId        String
  competencyId String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level        Int        @default(1) // 필요 역량 수준

  @@id([jobId, competencyId])
}

model CourseCompetency {
  courseId     String
  competencyId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([courseId, competencyId])
}

// ============================================
// APPROVAL (전자결재)
// ============================================

model Approval {
  id            String        @id @default(cuid())
  docNumber     String        @unique // 문서번호
  type          ApprovalDocType
  title         String
  content       Json
  requesterId   String
  requester     User          @relation("ApprovalRequester", fields: [requesterId], references: [id])
  status        ApprovalStatus @default(PENDING)
  currentStep   Int           @default(1)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
  lines         ApprovalLine[]
  appointments  Appointment[]
  leaves        Leave[]

  @@index([requesterId])
  @@index([status])
  @@index([type])
}

model ApprovalLine {
  id          String     @id @default(cuid())
  approvalId  String
  approval    Approval   @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  sequence    Int
  approverId  String
  approver    User       @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      LineStatus @default(PENDING)
  comment     String?
  actedAt     DateTime?

  @@unique([approvalId, sequence])
  @@index([approverId])
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // CREATE, READ, UPDATE, DELETE
  entityType  String   // User, Employee, Salary, etc.
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String
  description String?
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  isRecurring Boolean @default(false) // 매년 반복 여부
  createdAt DateTime @default(now())

  @@unique([date])
}

// ============================================
// AUTOMATION (HR 업무 자동화)
// ============================================

enum AutomationType {
  ONBOARDING       // 입사 자동화
  OFFBOARDING      // 퇴사 자동화
  APPOINTMENT      // 인사 발령
  ATTENDANCE_ALERT // 근태 이상 감지
  NOTIFICATION     // 알림 자동화
  LEAVE_BALANCE    // 연차 자동 부여
  EVALUATION_CYCLE // 평가 주기
}

enum AutomationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

// 자동화 규칙
model AutomationRule {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        AutomationType
  trigger     Json           // 트리거 조건 { event: "EMPLOYEE_HIRED", conditions: [] }
  actions     Json           // 실행 액션 [{ type: "CREATE_ACCOUNT", params: {} }]
  schedule    String?        // Cron 표현식 (스케줄 기반)
  isActive    Boolean        @default(true)
  priority    Int            @default(0)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  logs        AutomationLog[]

  @@index([type])
  @@index([isActive])
}

// 자동화 실행 로그
model AutomationLog {
  id          String           @id @default(cuid())
  ruleId      String
  rule        AutomationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  employeeId  String?
  status      AutomationStatus @default(PENDING)
  triggerData Json?            // 트리거된 데이터
  result      Json?            // 실행 결과
  error       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([ruleId])
  @@index([employeeId])
  @@index([status])
  @@index([startedAt])
}

// 근태 이상 알림
model AttendanceAlert {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  alertType   String   // LATE, ABSENT, EARLY_LEAVE, OVERTIME_EXCESS
  message     String
  isResolved  Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@index([alertType])
  @@index([isResolved])
}

// ============================================
// PHASE 1: STRATEGIC HR & WORKFORCE OPERATIONS
// ============================================

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ScenarioStatus {
  DRAFT
  ANALYZING
  COMPLETED
}

enum SimulationStatus {
  DRAFT
  RUNNING
  COMPLETED
}

// 인력 계획
model WorkforcePlan {
  id              String     @id @default(cuid())
  year            Int
  quarter         Int?       // null = 연간 계획
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  currentHeadcount Int
  plannedHeadcount Int
  budgetAmount    Decimal    @db.Decimal(15, 2)
  status          PlanStatus @default(DRAFT)
  notes           String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([year, quarter, organizationId])
  @@index([organizationId])
  @@index([year])
}

// 정원 관리
model HeadcountLimit {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  limitCount      Int
  effectiveDate   DateTime
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([effectiveDate])
}

// 시나리오 분석
model HeadcountScenario {
  id            String         @id @default(cuid())
  name          String
  description   String?
  baselineData  Json           // 현재 상태 스냅샷
  changes       Json           // 증원/감원 변경 내역
  costImpact    Decimal        @db.Decimal(15, 2)
  status        ScenarioStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

// 인건비 예측
model LaborCostForecast {
  id              String   @id @default(cuid())
  yearMonth       String   // YYYYMM
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  baseSalary      Decimal  @db.Decimal(15, 2)
  bonus           Decimal  @db.Decimal(15, 2)
  benefits        Decimal  @db.Decimal(15, 2)
  totalCost       Decimal  @db.Decimal(15, 2)
  isActual        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([yearMonth, organizationId])
  @@index([yearMonth])
  @@index([organizationId])
}

// 조직 개편 시뮬레이션
model OrgRestructureSimulation {
  id                String           @id @default(cuid())
  name              String
  description       String?
  currentStructure  Json
  proposedStructure Json
  impactAnalysis    Json?            // 영향 분석 결과
  status            SimulationStatus @default(DRAFT)
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}

// ============================================
// PHASE 2: RECRUITMENT MANAGEMENT
// ============================================

enum PostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  PASSED
  REJECTED
  WITHDRAWN
}

enum RecruitmentStage {
  DOCUMENT          // 서류
  FIRST_INTERVIEW   // 1차 면접
  SECOND_INTERVIEW  // 2차 면접
  FINAL_INTERVIEW   // 최종 면접
  OFFER             // 합격
  ONBOARDING        // 입사
}

enum StageResult {
  PASSED
  FAILED
  PENDING
}

enum EvaluationRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

// 채용 공고
model JobPosting {
  id              String         @id @default(cuid())
  title           String
  organizationId  String
  positionId      String
  description     String         @db.Text
  requirements    String         @db.Text
  benefits        String?        @db.Text
  salaryRange     String?
  employmentType  EmploymentType
  location        String?
  status          PostingStatus  @default(DRAFT)
  publishedAt     DateTime?
  closingDate     DateTime?
  applications    Application[]
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([closingDate])
}

// 지원자
model Applicant {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  phone           String?
  resumeUrl       String?
  portfolioUrl    String?
  source          String?       // 지원 경로
  isInTalentPool  Boolean       @default(false)
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
  @@index([isInTalentPool])
}

// 지원서
model Application {
  id              String              @id @default(cuid())
  postingId       String
  posting         JobPosting          @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status          ApplicationStatus   @default(SUBMITTED)
  currentStage    RecruitmentStage    @default(DOCUMENT)
  coverLetter     String?             @db.Text
  appliedAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  stages          ApplicationStageHistory[]
  evaluations     InterviewEvaluation[]

  @@unique([postingId, applicantId])
  @@index([postingId])
  @@index([applicantId])
  @@index([status])
  @@index([currentStage])
}

// 채용 단계 이력
model ApplicationStageHistory {
  id              String           @id @default(cuid())
  applicationId   String
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage           RecruitmentStage
  result          StageResult?
  notes           String?
  processedBy     String?
  processedAt     DateTime         @default(now())

  @@index([applicationId])
  @@index([stage])
}

// 면접 평가 템플릿
model InterviewTemplate {
  id              String                @id @default(cuid())
  name            String
  description     String?
  items           Json                  // 평가 항목 및 가중치
  isActive        Boolean               @default(true)
  evaluations     InterviewEvaluation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

// 면접 평가
model InterviewEvaluation {
  id              String                   @id @default(cuid())
  applicationId   String
  application     Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId   String
  templateId      String
  template        InterviewTemplate        @relation(fields: [templateId], references: [id])
  stage           RecruitmentStage
  scores          Json                     // 항목별 점수
  overallScore    Decimal                  @db.Decimal(5, 2)
  recommendation  EvaluationRecommendation
  comments        String?                  @db.Text
  evaluatedAt     DateTime                 @default(now())

  @@index([applicationId])
  @@index([interviewerId])
  @@index([templateId])
}

// ============================================
// PHASE 3: HR POLICY & REGULATIONS MANAGEMENT
// ============================================

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  DEPRECATED
}

// 정책 카테고리
model PolicyCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  parentId    String?
  parent      PolicyCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    PolicyCategory[] @relation("CategoryHierarchy")
  policies    Policy[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 인사 정책/규정
model Policy {
  id              String          @id @default(cuid())
  code            String          @unique
  title           String
  categoryId      String?
  category        PolicyCategory? @relation(fields: [categoryId], references: [id])
  currentVersion  Int             @default(1)
  status          PolicyStatus    @default(DRAFT)
  effectiveDate   DateTime?
  expiryDate      DateTime?
  keywords        String[]        // 검색용 키워드
  requiresAcknowledgment Boolean  @default(false)
  versions        PolicyVersion[]
  acknowledgments PolicyAcknowledgment[]
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([effectiveDate])
}

// 정책 버전 (개정 이력)
model PolicyVersion {
  id              String   @id @default(cuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber   Int
  content         String   @db.Text
  summary         String?  // 개정 요약
  changeNotes     String?  @db.Text // 변경 사항
  effectiveDate   DateTime
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([policyId, versionNumber])
  @@index([policyId])
}

// 정책 확인/동의 이력
model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId          String
  versionNumber   Int
  acknowledgedAt  DateTime @default(now())
  ipAddress       String?

  @@unique([policyId, userId, versionNumber])
  @@index([policyId])
  @@index([userId])
}

// ============================================
// PHASE 4: CERTIFICATE & DOCUMENT AUTOMATION
// ============================================

enum CertificateType {
  EMPLOYMENT         // 재직증명서
  CAREER             // 경력증명서
  SALARY             // 급여증명서
  POSITION           // 직위증명서
  CUSTOM             // 기타
}

enum CertificateStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
  EXPIRED
}

// 증명서 템플릿
model CertificateTemplate {
  id             String            @id @default(cuid())
  name           String
  type           CertificateType
  content        String            @db.Text  // HTML 또는 마크다운 템플릿
  variables      Json              // 사용 가능한 변수 목록
  isActive       Boolean           @default(true)
  issuances      CertificateIssuance[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// 증명서 발급 이력
model CertificateIssuance {
  id              String            @id @default(cuid())
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  employeeId      String
  requestedBy     String
  purpose         String?           // 발급 목적
  status          CertificateStatus @default(REQUESTED)
  approvedBy      String?
  approvedAt      DateTime?
  issuedAt        DateTime?
  expiryDate      DateTime?         // 증명서 유효기간
  verificationCode String           @unique  // 외부 검증용 코드
  documentUrl     String?           // 생성된 PDF URL
  signatureData   Json?             // 전자서명 데이터
  createdAt       DateTime          @default(now())

  @@index([employeeId])
  @@index([templateId])
  @@index([status])
  @@index([verificationCode])
}

// ============================================
// PHASE 5: LABOR & COMPLIANCE
// ============================================

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  RENEWED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  OVERTIME_LIMIT        // 법정 근로시간 초과
  CONTRACT_EXPIRY       // 계약 만료
  COMPLIANCE_VIOLATION  // 컴플라이언스 위반
  LEGAL_UPDATE         // 법규 변경
  RISK_DETECTED        // 노무 리스크
}

// 근로 계약
model LaborContract {
  id              String          @id @default(cuid())
  employeeId      String
  contractType    String          // 정규직, 계약직, 수습 등
  startDate       DateTime
  endDate         DateTime?
  probationEnd    DateTime?       // 수습 종료일
  workingHours    Int             @default(40)  // 주간 근무시간
  status          ContractStatus  @default(ACTIVE)
  terms           Json?           // 계약 조건
  documentUrl     String?         // 계약서 URL
  renewalCount    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([endDate])
}

// 컴플라이언스 규칙
model ComplianceRule {
  id              String   @id @default(cuid())
  name            String
  description     String?
  ruleType        AlertType
  threshold       Json     // 규칙 임계값 (예: maxOvertimeHours: 12)
  isActive        Boolean  @default(true)
  alerts          ComplianceAlert[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 컴플라이언스 경고
model ComplianceAlert {
  id              String        @id @default(cuid())
  ruleId          String?
  rule            ComplianceRule? @relation(fields: [ruleId], references: [id])
  type            AlertType
  severity        AlertSeverity
  title           String
  message         String        @db.Text
  employeeId      String?
  data            Json?         // 관련 데이터
  isResolved      Boolean       @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime      @default(now())

  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@index([employeeId])
}

// 법규 업데이트
model LegalUpdate {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  effectiveDate   DateTime
  category        String   // 근로기준법, 산업안전법 등
  sourceUrl       String?
  isReviewed      Boolean  @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  impactNotes     String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([effectiveDate])
  @@index([isReviewed])
}

// ============================================
// PHASE 6: DATA GOVERNANCE & QUALITY
// ============================================

enum DataIssueType {
  MISSING_DATA      // 결측치
  INCONSISTENCY     // 정합성 오류
  DUPLICATE         // 중복 데이터
  INVALID_FORMAT    // 형식 오류
  POLICY_VIOLATION  // 정책 위반
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

// 데이터 스냅샷 (변경 전후 기록)
model DataSnapshot {
  id            String   @id @default(cuid())
  entityType    String   // Employee, Organization 등
  entityId      String
  operation     String   // CREATE, UPDATE, DELETE
  beforeData    Json?
  afterData     Json?
  changedBy     String
  changedAt     DateTime @default(now())
  reason        String?

  @@index([entityType, entityId])
  @@index([changedAt])
  @@index([changedBy])
}

// 데이터 품질 이슈
model DataQualityIssue {
  id            String        @id @default(cuid())
  issueType     DataIssueType
  entityType    String
  entityId      String
  fieldName     String
  description   String
  severity      String        // LOW, MEDIUM, HIGH
  isResolved    Boolean       @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([issueType])
  @@index([isResolved])
  @@index([entityType, entityId])
}

// 데이터 삭제 요청 (GDPR)
model DataDeletionRequest {
  id              String                @id @default(cuid())
  requesterId     String                // 요청자 ID
  targetUserId    String                // 삭제 대상 사용자
  reason          String
  status          DeletionRequestStatus @default(PENDING)
  processedBy     String?
  processedAt     DateTime?
  deletedEntities Json?                 // 삭제된 엔티티 목록
  createdAt       DateTime              @default(now())

  @@index([status])
  @@index([targetUserId])
}

// 민감 데이터 마스킹 규칙
model DataMaskingRule {
  id            String   @id @default(cuid())
  name          String
  entityType    String   // 대상 엔티티
  fieldName     String   // 대상 필드
  maskingType   String   // FULL, PARTIAL, HASH, ENCRYPT
  pattern       String?  // 마스킹 패턴 (예: ***-****-****)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, fieldName])
}

// ============================================
// PHASE 7: API & PLATFORM EXTENSION
// ============================================

// API 클라이언트 (OAuth2)
model ApiClient {
  id              String   @id @default(cuid())
  name            String
  clientId        String   @unique
  clientSecret    String
  description     String?
  allowedScopes   String[] // 허용된 권한 범위
  allowedOrigins  String[] // CORS 허용 도메인
  isActive        Boolean  @default(true)
  rateLimitPerMin Int      @default(60)
  logs            ApiLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

// Webhook 설정
model Webhook {
  id            String   @id @default(cuid())
  name          String
  url           String
  events        String[] // 구독 이벤트 목록
  secret        String?  // 검증용 시크릿
  isActive      Boolean  @default(true)
  lastTriggered DateTime?
  failureCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// API 호출 로그
model ApiLog {
  id            String    @id @default(cuid())
  clientId      String?
  client        ApiClient? @relation(fields: [clientId], references: [id])
  method        String
  endpoint      String
  statusCode    Int
  requestBody   Json?
  responseTime  Int       // ms
  ipAddress     String?
  userAgent     String?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([clientId])
  @@index([endpoint])
  @@index([createdAt])
}

// 외부 연동 설정 (ERP, 그룹웨어 등)
model ExternalIntegration {
  id            String   @id @default(cuid())
  name          String
  type          String   // ERP, GROUPWARE, SLACK, etc.
  config        Json     // 연동 설정 정보
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  syncStatus    String?  // SUCCESS, FAILED, IN_PROGRESS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// PHASE 8: OPERATIONAL STABILITY & SRE
// ============================================

enum IncidentSeverity {
  P1_CRITICAL
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// 장애/인시던트 관리
model Incident {
  id              String           @id @default(cuid())
  title           String
  description     String           @db.Text
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  affectedSystems String[]
  assignedTo      String?
  startedAt       DateTime         @default(now())
  resolvedAt      DateTime?
  rootCause       String?          @db.Text
  resolution      String?          @db.Text
  timeline        Json?            // 타임라인 이벤트
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([severity])
  @@index([status])
  @@index([startedAt])
}

// 성능 메트릭
model PerformanceMetric {
  id            String   @id @default(cuid())
  endpoint      String
  method        String
  responseTime  Int      // ms
  statusCode    Int
  timestamp     DateTime @default(now())
  metadata      Json?

  @@index([endpoint])
  @@index([timestamp])
}

// 백업 스케줄
model BackupSchedule {
  id            String   @id @default(cuid())
  name          String
  type          String   // FULL, INCREMENTAL, DIFFERENTIAL
  schedule      String   // Cron expression
  retentionDays Int      @default(30)
  isActive      Boolean  @default(true)
  lastRunAt     DateTime?
  lastStatus    String?  // SUCCESS, FAILED
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 배포 기록
model DeploymentRecord {
  id            String   @id @default(cuid())
  version       String
  environment   String   // production, staging, development
  deployedBy    String
  deployedAt    DateTime @default(now())
  status        String   // SUCCESS, FAILED, ROLLBACK
  changelog     String?  @db.Text
  rollbackFrom  String?  // 롤백 시 이전 버전
  duration      Int?     // 배포 소요 시간 (초)

  @@index([environment])
  @@index([deployedAt])
}

