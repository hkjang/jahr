// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgLevel {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
}

enum EmploymentType {
  REGULAR
  CONTRACT
  INTERN
  PART_TIME
}

enum WorkType {
  OFFICE
  REMOTE
  HYBRID
  FLEXIBLE
}

enum Degree {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
}

enum FamilyRelation {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum DocumentType {
  CONTRACT
  CERTIFICATE
  ID_CARD
  RESUME
  OTHER
}

enum AppointmentType {
  HIRE
  PROMOTION
  TRANSFER
  DEMOTION
  RESIGNATION
  RETIREMENT
  LEAVE_OF_ABSENCE
  RETURN_FROM_LEAVE
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  ABSENT
  HOLIDAY
  LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  OFFICIAL
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LineStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalDocType {
  LEAVE_REQUEST
  APPOINTMENT
  EXPENSE
  OVERTIME
  BUSINESS_TRIP
  OTHER
}

enum SalaryItemType {
  EARNING
  DEDUCTION
}

enum EvaluationType {
  HALF_YEARLY
  YEARLY
}

enum PeriodStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum EvaluationStatus {
  NOT_STARTED
  SELF_EVALUATION
  MANAGER_EVALUATION
  COMPLETED
}

enum EvaluationGrade {
  S
  A
  B
  C
  D
}

enum CourseType {
  INTERNAL
  EXTERNAL
  ONLINE
  OFFLINE
}

enum TrainingStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String     @id @default(cuid())
  employeeId    String     @unique // 사번
  email         String     @unique
  password      String
  name          String
  phoneNumber   String?
  birthDate     DateTime?
  profileImage  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  employee            Employee?
  roles               UserRole[]
  auditLogs           AuditLog[]
  sessions            Session[]
  approvalRequests    Approval[]     @relation("ApprovalRequester")
  approvalLines       ApprovalLine[] @relation("ApprovalApprover")
  notifications       Notification[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  module   String
  action   String
  scope    String   @default("self")
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

// ============================================
// ORGANIZATION
// ============================================

model Organization {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  level       OrgLevel
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  parentId    String?
  parent      Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgHierarchy")
  employees   Employee[]
  workforcePlans WorkforcePlan[]
  headcountLimits HeadcountLimit[]
  laborCostForecasts LaborCostForecast[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentId])
  @@index([code])
}

model Position {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  level       Int        // 숫자가 낮을수록 높은 직급
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([level])
}

model JobTitle {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String     // 과장, 부장, 팀장 등 직책
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Job {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  competencies JobCompetency[]
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ============================================
// EMPLOYEE
// ============================================

model Employee {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])

  positionId      String
  position        Position       @relation(fields: [positionId], references: [id])

  jobTitleId      String?
  jobTitle        JobTitle?      @relation(fields: [jobTitleId], references: [id])

  jobId           String?
  job             Job?           @relation(fields: [jobId], references: [id])

  hireDate        DateTime
  employmentType  EmploymentType @default(REGULAR)
  workType        WorkType       @default(OFFICE)

  // 겸직 관리
  additionalOrgs  EmployeeOrganization[]

  educations      Education[]
  careers         Career[]
  families        Family[]
  documents       Document[]
  appointments    Appointment[]
  attendances     Attendance[]
  leaves          Leave[]
  leaveBalances   LeaveBalance[]
  salaries        Salary[]
  evaluations     Evaluation[]
  trainings       Training[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([positionId])
  @@index([hireDate])
}

// 겸직 관리
model EmployeeOrganization {
  id              String       @id @default(cuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId  String
  startDate       DateTime
  endDate         DateTime?
  isPrimary       Boolean      @default(false)

  @@unique([employeeId, organizationId])
}

model Education {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schoolName   String
  major        String?
  degree       Degree
  startDate    DateTime
  endDate      DateTime?
  graduated    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
}

model Career {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyName String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

model Family {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  relation    FamilyRelation
  name        String
  birthDate   DateTime?
  contact     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
}

model Document {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String?
  uploadedAt  DateTime     @default(now())

  @@index([employeeId])
  @@index([type])
}

model Appointment {
  id               String          @id @default(cuid())
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             AppointmentType
  effectiveDate    DateTime
  previousOrgId    String?
  newOrgId         String?
  previousPositionId String?
  newPositionId    String?
  reason           String?
  approvalId       String?
  approval         Approval?       @relation(fields: [approvalId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
  @@index([type])
}

// ============================================
// ATTENDANCE & LEAVE
// ============================================

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  workType    WorkType         @default(OFFICE)
  status      AttendanceStatus @default(NORMAL)
  workMinutes Int?             // 실 근무시간 (분)
  overtimeMinutes Int?         // 초과근무시간 (분)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Leave {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Float          // 0.5 = 반차
  reason      String?
  status      ApprovalStatus @default(PENDING)
  approvalId  String?
  approval    Approval?      @relation(fields: [approvalId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int
  leaveType   LeaveType @default(ANNUAL)
  totalDays   Float
  usedDays    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
}

// ============================================
// SALARY
// ============================================

model Salary {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  yearMonth     String   // YYYYMM
  baseSalary    Decimal  @db.Decimal(15, 2)
  bonus         Decimal  @default(0) @db.Decimal(15, 2)
  allowances    Json     // 수당 상세 { "식대": 100000, "교통비": 50000 }
  deductions    Json     // 공제 상세 { "소득세": 50000, "국민연금": 40000 }
  totalEarnings Decimal  @db.Decimal(15, 2)
  totalDeductions Decimal @db.Decimal(15, 2)
  netSalary     Decimal  @db.Decimal(15, 2)
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, yearMonth])
  @@index([employeeId])
  @@index([yearMonth])
}

model SalaryItem {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  type     SalaryItemType
  formula  String?        // 계산 공식
  isActive Boolean        @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ============================================
// EVALUATION
// ============================================

model EvaluationPeriod {
  id          String       @id @default(cuid())
  name        String
  year        Int
  type        EvaluationType
  startDate   DateTime
  endDate     DateTime
  status      PeriodStatus @default(DRAFT)
  evaluations Evaluation[]
  templates   EvaluationTemplate[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([year, type])
}

model EvaluationTemplate {
  id          String           @id @default(cuid())
  periodId    String
  period      EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String
  items       EvaluationTemplateItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EvaluationTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String
  name        String
  description String?
  weight      Float              // 가중치 (%)
  maxScore    Float              @default(5)
  sortOrder   Int                @default(0)
}

model Evaluation {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodId     String
  period       EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  selfScore    Decimal?         @db.Decimal(5, 2)
  managerScore Decimal?         @db.Decimal(5, 2)
  finalScore   Decimal?         @db.Decimal(5, 2)
  grade        EvaluationGrade?
  status       EvaluationStatus @default(NOT_STARTED)
  selfComment  String?
  managerComment String?
  items        EvaluationItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, periodId])
  @@index([employeeId])
  @@index([periodId])
}

model EvaluationItem {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  category     String
  name         String
  weight       Float
  selfScore    Decimal?   @db.Decimal(5, 2)
  managerScore Decimal?   @db.Decimal(5, 2)
  selfComment  String?
  managerComment String?
}

// ============================================
// TRAINING
// ============================================

model Course {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  type         CourseType
  description  String?
  instructor   String?
  duration     Int          // 시간
  maxCapacity  Int?
  competencies CourseCompetency[]
  isActive     Boolean      @default(true)
  trainings    Training[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Training {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  status      TrainingStatus @default(ENROLLED)
  score       Decimal?       @db.Decimal(5, 2)
  certificate String?
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
  @@index([courseId])
}

// 역량 관리
model Competency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  jobs        JobCompetency[]
  courses     CourseCompetency[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobCompetency {
  jobId        String
  competencyId String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level        Int        @default(1) // 필요 역량 수준

  @@id([jobId, competencyId])
}

model CourseCompetency {
  courseId     String
  competencyId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([courseId, competencyId])
}

// ============================================
// APPROVAL (전자결재)
// ============================================

model Approval {
  id            String        @id @default(cuid())
  docNumber     String        @unique // 문서번호
  type          ApprovalDocType
  title         String
  content       Json
  requesterId   String
  requester     User          @relation("ApprovalRequester", fields: [requesterId], references: [id])
  status        ApprovalStatus @default(PENDING)
  currentStep   Int           @default(1)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
  lines         ApprovalLine[]
  appointments  Appointment[]
  leaves        Leave[]

  @@index([requesterId])
  @@index([status])
  @@index([type])
}

model ApprovalLine {
  id          String     @id @default(cuid())
  approvalId  String
  approval    Approval   @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  sequence    Int
  approverId  String
  approver    User       @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      LineStatus @default(PENDING)
  comment     String?
  actedAt     DateTime?

  @@unique([approvalId, sequence])
  @@index([approverId])
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // CREATE, READ, UPDATE, DELETE
  entityType  String   // User, Employee, Salary, etc.
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String
  description String?
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  isRecurring Boolean @default(false) // 매년 반복 여부
  createdAt DateTime @default(now())

  @@unique([date])
}

// ============================================
// AUTOMATION (HR 업무 자동화)
// ============================================

enum AutomationType {
  ONBOARDING       // 입사 자동화
  OFFBOARDING      // 퇴사 자동화
  APPOINTMENT      // 인사 발령
  ATTENDANCE_ALERT // 근태 이상 감지
  NOTIFICATION     // 알림 자동화
  LEAVE_BALANCE    // 연차 자동 부여
  EVALUATION_CYCLE // 평가 주기
}

enum AutomationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

// 자동화 규칙
model AutomationRule {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        AutomationType
  trigger     Json           // 트리거 조건 { event: "EMPLOYEE_HIRED", conditions: [] }
  actions     Json           // 실행 액션 [{ type: "CREATE_ACCOUNT", params: {} }]
  schedule    String?        // Cron 표현식 (스케줄 기반)
  isActive    Boolean        @default(true)
  priority    Int            @default(0)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  logs        AutomationLog[]

  @@index([type])
  @@index([isActive])
}

// 자동화 실행 로그
model AutomationLog {
  id          String           @id @default(cuid())
  ruleId      String
  rule        AutomationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  employeeId  String?
  status      AutomationStatus @default(PENDING)
  triggerData Json?            // 트리거된 데이터
  result      Json?            // 실행 결과
  error       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([ruleId])
  @@index([employeeId])
  @@index([status])
  @@index([startedAt])
}

// 근태 이상 알림
model AttendanceAlert {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  alertType   String   // LATE, ABSENT, EARLY_LEAVE, OVERTIME_EXCESS
  message     String
  isResolved  Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@index([alertType])
  @@index([isResolved])
}

// ============================================
// PHASE 1: STRATEGIC HR & WORKFORCE OPERATIONS
// ============================================

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ScenarioStatus {
  DRAFT
  ANALYZING
  COMPLETED
}

enum SimulationStatus {
  DRAFT
  RUNNING
  COMPLETED
}

// 인력 계획
model WorkforcePlan {
  id              String     @id @default(cuid())
  year            Int
  quarter         Int?       // null = 연간 계획
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  currentHeadcount Int
  plannedHeadcount Int
  budgetAmount    Decimal    @db.Decimal(15, 2)
  status          PlanStatus @default(DRAFT)
  notes           String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([year, quarter, organizationId])
  @@index([organizationId])
  @@index([year])
}

// 정원 관리
model HeadcountLimit {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  limitCount      Int
  effectiveDate   DateTime
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([effectiveDate])
}

// 시나리오 분석
model HeadcountScenario {
  id            String         @id @default(cuid())
  name          String
  description   String?
  baselineData  Json           // 현재 상태 스냅샷
  changes       Json           // 증원/감원 변경 내역
  costImpact    Decimal        @db.Decimal(15, 2)
  status        ScenarioStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

// 인건비 예측
model LaborCostForecast {
  id              String   @id @default(cuid())
  yearMonth       String   // YYYYMM
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  baseSalary      Decimal  @db.Decimal(15, 2)
  bonus           Decimal  @db.Decimal(15, 2)
  benefits        Decimal  @db.Decimal(15, 2)
  totalCost       Decimal  @db.Decimal(15, 2)
  isActual        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([yearMonth, organizationId])
  @@index([yearMonth])
  @@index([organizationId])
}

// 조직 개편 시뮬레이션
model OrgRestructureSimulation {
  id                String           @id @default(cuid())
  name              String
  description       String?
  currentStructure  Json
  proposedStructure Json
  impactAnalysis    Json?            // 영향 분석 결과
  status            SimulationStatus @default(DRAFT)
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}

// ============================================
// PHASE 2: RECRUITMENT MANAGEMENT
// ============================================

enum PostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  PASSED
  REJECTED
  WITHDRAWN
}

enum RecruitmentStage {
  DOCUMENT          // 서류
  FIRST_INTERVIEW   // 1차 면접
  SECOND_INTERVIEW  // 2차 면접
  FINAL_INTERVIEW   // 최종 면접
  OFFER             // 합격
  ONBOARDING        // 입사
}

enum StageResult {
  PASSED
  FAILED
  PENDING
}

enum EvaluationRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

// 채용 공고
model JobPosting {
  id              String         @id @default(cuid())
  title           String
  organizationId  String
  positionId      String
  description     String         @db.Text
  requirements    String         @db.Text
  benefits        String?        @db.Text
  salaryRange     String?
  employmentType  EmploymentType
  location        String?
  status          PostingStatus  @default(DRAFT)
  publishedAt     DateTime?
  closingDate     DateTime?
  applications    Application[]
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([closingDate])
}

// 지원자
model Applicant {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  phone           String?
  resumeUrl       String?
  portfolioUrl    String?
  source          String?       // 지원 경로
  isInTalentPool  Boolean       @default(false)
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
  @@index([isInTalentPool])
}

// 지원서
model Application {
  id              String              @id @default(cuid())
  postingId       String
  posting         JobPosting          @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       Applicant           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status          ApplicationStatus   @default(SUBMITTED)
  currentStage    RecruitmentStage    @default(DOCUMENT)
  coverLetter     String?             @db.Text
  appliedAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  stages          ApplicationStageHistory[]
  evaluations     InterviewEvaluation[]

  @@unique([postingId, applicantId])
  @@index([postingId])
  @@index([applicantId])
  @@index([status])
  @@index([currentStage])
}

// 채용 단계 이력
model ApplicationStageHistory {
  id              String           @id @default(cuid())
  applicationId   String
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage           RecruitmentStage
  result          StageResult?
  notes           String?
  processedBy     String?
  processedAt     DateTime         @default(now())

  @@index([applicationId])
  @@index([stage])
}

// 면접 평가 템플릿
model InterviewTemplate {
  id              String                @id @default(cuid())
  name            String
  description     String?
  items           Json                  // 평가 항목 및 가중치
  isActive        Boolean               @default(true)
  evaluations     InterviewEvaluation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

// 면접 평가
model InterviewEvaluation {
  id              String                   @id @default(cuid())
  applicationId   String
  application     Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId   String
  templateId      String
  template        InterviewTemplate        @relation(fields: [templateId], references: [id])
  stage           RecruitmentStage
  scores          Json                     // 항목별 점수
  overallScore    Decimal                  @db.Decimal(5, 2)
  recommendation  EvaluationRecommendation
  comments        String?                  @db.Text
  evaluatedAt     DateTime                 @default(now())

  @@index([applicationId])
  @@index([interviewerId])
  @@index([templateId])
}

// ============================================
// PHASE 3: HR POLICY & REGULATIONS MANAGEMENT
// ============================================

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  DEPRECATED
}

// 정책 카테고리
model PolicyCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  parentId    String?
  parent      PolicyCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    PolicyCategory[] @relation("CategoryHierarchy")
  policies    Policy[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 인사 정책/규정
model Policy {
  id              String          @id @default(cuid())
  code            String          @unique
  title           String
  categoryId      String?
  category        PolicyCategory? @relation(fields: [categoryId], references: [id])
  currentVersion  Int             @default(1)
  status          PolicyStatus    @default(DRAFT)
  effectiveDate   DateTime?
  expiryDate      DateTime?
  keywords        String[]        // 검색용 키워드
  requiresAcknowledgment Boolean  @default(false)
  versions        PolicyVersion[]
  acknowledgments PolicyAcknowledgment[]
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([effectiveDate])
}

// 정책 버전 (개정 이력)
model PolicyVersion {
  id              String   @id @default(cuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber   Int
  content         String   @db.Text
  summary         String?  // 개정 요약
  changeNotes     String?  @db.Text // 변경 사항
  effectiveDate   DateTime
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([policyId, versionNumber])
  @@index([policyId])
}

// 정책 확인/동의 이력
model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId          String
  versionNumber   Int
  acknowledgedAt  DateTime @default(now())
  ipAddress       String?

  @@unique([policyId, userId, versionNumber])
  @@index([policyId])
  @@index([userId])
}

// ============================================
// PHASE 4: CERTIFICATE & DOCUMENT AUTOMATION
// ============================================

enum CertificateType {
  EMPLOYMENT         // 재직증명서
  CAREER             // 경력증명서
  SALARY             // 급여증명서
  POSITION           // 직위증명서
  CUSTOM             // 기타
}

enum CertificateStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
  EXPIRED
}

// 증명서 템플릿
model CertificateTemplate {
  id             String            @id @default(cuid())
  name           String
  type           CertificateType
  content        String            @db.Text  // HTML 또는 마크다운 템플릿
  variables      Json              // 사용 가능한 변수 목록
  isActive       Boolean           @default(true)
  issuances      CertificateIssuance[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// 증명서 발급 이력
model CertificateIssuance {
  id              String            @id @default(cuid())
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  employeeId      String
  requestedBy     String
  purpose         String?           // 발급 목적
  status          CertificateStatus @default(REQUESTED)
  approvedBy      String?
  approvedAt      DateTime?
  issuedAt        DateTime?
  expiryDate      DateTime?         // 증명서 유효기간
  verificationCode String           @unique  // 외부 검증용 코드
  documentUrl     String?           // 생성된 PDF URL
  signatureData   Json?             // 전자서명 데이터
  createdAt       DateTime          @default(now())

  @@index([employeeId])
  @@index([templateId])
  @@index([status])
  @@index([verificationCode])
}

// ============================================
// PHASE 5: LABOR & COMPLIANCE
// ============================================

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  RENEWED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  OVERTIME_LIMIT        // 법정 근로시간 초과
  CONTRACT_EXPIRY       // 계약 만료
  COMPLIANCE_VIOLATION  // 컴플라이언스 위반
  LEGAL_UPDATE         // 법규 변경
  RISK_DETECTED        // 노무 리스크
}

// 근로 계약
model LaborContract {
  id              String          @id @default(cuid())
  employeeId      String
  contractType    String          // 정규직, 계약직, 수습 등
  startDate       DateTime
  endDate         DateTime?
  probationEnd    DateTime?       // 수습 종료일
  workingHours    Int             @default(40)  // 주간 근무시간
  status          ContractStatus  @default(ACTIVE)
  terms           Json?           // 계약 조건
  documentUrl     String?         // 계약서 URL
  renewalCount    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([endDate])
}

// 컴플라이언스 규칙
model ComplianceRule {
  id              String   @id @default(cuid())
  name            String
  description     String?
  ruleType        AlertType
  threshold       Json     // 규칙 임계값 (예: maxOvertimeHours: 12)
  isActive        Boolean  @default(true)
  alerts          ComplianceAlert[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 컴플라이언스 경고
model ComplianceAlert {
  id              String        @id @default(cuid())
  ruleId          String?
  rule            ComplianceRule? @relation(fields: [ruleId], references: [id])
  type            AlertType
  severity        AlertSeverity
  title           String
  message         String        @db.Text
  employeeId      String?
  data            Json?         // 관련 데이터
  isResolved      Boolean       @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime      @default(now())

  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@index([employeeId])
}

// 법규 업데이트
model LegalUpdate {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  effectiveDate   DateTime
  category        String   // 근로기준법, 산업안전법 등
  sourceUrl       String?
  isReviewed      Boolean  @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  impactNotes     String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([effectiveDate])
  @@index([isReviewed])
}

// ============================================
// PHASE 6: DATA GOVERNANCE & QUALITY
// ============================================

enum DataIssueType {
  MISSING_DATA      // 결측치
  INCONSISTENCY     // 정합성 오류
  DUPLICATE         // 중복 데이터
  INVALID_FORMAT    // 형식 오류
  POLICY_VIOLATION  // 정책 위반
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

// 데이터 스냅샷 (변경 전후 기록)
model DataSnapshot {
  id            String   @id @default(cuid())
  entityType    String   // Employee, Organization 등
  entityId      String
  operation     String   // CREATE, UPDATE, DELETE
  beforeData    Json?
  afterData     Json?
  changedBy     String
  changedAt     DateTime @default(now())
  reason        String?

  @@index([entityType, entityId])
  @@index([changedAt])
  @@index([changedBy])
}

// 데이터 품질 이슈
model DataQualityIssue {
  id            String        @id @default(cuid())
  issueType     DataIssueType
  entityType    String
  entityId      String
  fieldName     String
  description   String
  severity      String        // LOW, MEDIUM, HIGH
  isResolved    Boolean       @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([issueType])
  @@index([isResolved])
  @@index([entityType, entityId])
}

// 데이터 삭제 요청 (GDPR)
model DataDeletionRequest {
  id              String                @id @default(cuid())
  requesterId     String                // 요청자 ID
  targetUserId    String                // 삭제 대상 사용자
  reason          String
  status          DeletionRequestStatus @default(PENDING)
  processedBy     String?
  processedAt     DateTime?
  deletedEntities Json?                 // 삭제된 엔티티 목록
  createdAt       DateTime              @default(now())

  @@index([status])
  @@index([targetUserId])
}

// 민감 데이터 마스킹 규칙
model DataMaskingRule {
  id            String   @id @default(cuid())
  name          String
  entityType    String   // 대상 엔티티
  fieldName     String   // 대상 필드
  maskingType   String   // FULL, PARTIAL, HASH, ENCRYPT
  pattern       String?  // 마스킹 패턴 (예: ***-****-****)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, fieldName])
}

// ============================================
// PHASE 7: API & PLATFORM EXTENSION
// ============================================

// API 클라이언트 (OAuth2)
model ApiClient {
  id              String   @id @default(cuid())
  name            String
  clientId        String   @unique
  clientSecret    String
  description     String?
  allowedScopes   String[] // 허용된 권한 범위
  allowedOrigins  String[] // CORS 허용 도메인
  isActive        Boolean  @default(true)
  rateLimitPerMin Int      @default(60)
  logs            ApiLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

// Webhook 설정
model Webhook {
  id            String   @id @default(cuid())
  name          String
  url           String
  events        String[] // 구독 이벤트 목록
  secret        String?  // 검증용 시크릿
  isActive      Boolean  @default(true)
  lastTriggered DateTime?
  failureCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// API 호출 로그
model ApiLog {
  id            String    @id @default(cuid())
  clientId      String?
  client        ApiClient? @relation(fields: [clientId], references: [id])
  method        String
  endpoint      String
  statusCode    Int
  requestBody   Json?
  responseTime  Int       // ms
  ipAddress     String?
  userAgent     String?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([clientId])
  @@index([endpoint])
  @@index([createdAt])
}

// 외부 연동 설정 (ERP, 그룹웨어 등)
model ExternalIntegration {
  id            String   @id @default(cuid())
  name          String
  type          String   // ERP, GROUPWARE, SLACK, etc.
  config        Json     // 연동 설정 정보
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  syncStatus    String?  // SUCCESS, FAILED, IN_PROGRESS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// PHASE 8: OPERATIONAL STABILITY & SRE
// ============================================

enum IncidentSeverity {
  P1_CRITICAL
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// 장애/인시던트 관리
model Incident {
  id              String           @id @default(cuid())
  title           String
  description     String           @db.Text
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  affectedSystems String[]
  assignedTo      String?
  startedAt       DateTime         @default(now())
  resolvedAt      DateTime?
  rootCause       String?          @db.Text
  resolution      String?          @db.Text
  timeline        Json?            // 타임라인 이벤트
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([severity])
  @@index([status])
  @@index([startedAt])
}

// 성능 메트릭
model PerformanceMetric {
  id            String   @id @default(cuid())
  endpoint      String
  method        String
  responseTime  Int      // ms
  statusCode    Int
  timestamp     DateTime @default(now())
  metadata      Json?

  @@index([endpoint])
  @@index([timestamp])
}

// 백업 스케줄
model BackupSchedule {
  id            String   @id @default(cuid())
  name          String
  type          String   // FULL, INCREMENTAL, DIFFERENTIAL
  schedule      String   // Cron expression
  retentionDays Int      @default(30)
  isActive      Boolean  @default(true)
  lastRunAt     DateTime?
  lastStatus    String?  // SUCCESS, FAILED
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 배포 기록
model DeploymentRecord {
  id            String   @id @default(cuid())
  version       String
  environment   String   // production, staging, development
  deployedBy    String
  deployedAt    DateTime @default(now())
  status        String   // SUCCESS, FAILED, ROLLBACK
  changelog     String?  @db.Text
  rollbackFrom  String?  // 롤백 시 이전 버전
  duration      Int?     // 배포 소요 시간 (초)

  @@index([environment])
  @@index([deployedAt])
}

// ============================================
// PHASE 9: HR DATA-BASED DECISION SUPPORT
// ============================================

// CEO 경영 리포트
model ExecutiveReport {
  id            String   @id @default(cuid())
  title         String
  reportType    String   // MONTHLY, QUARTERLY, ANNUAL, CUSTOM
  period        String   // 2024-Q1, 2024-12 등
  data          Json     // 리포트 데이터
  summary       String?  @db.Text
  keyInsights   String[] // 핵심 인사이트
  generatedAt   DateTime @default(now())
  generatedBy   String

  @@index([reportType])
  @@index([period])
}

// 이직 위험 분석
model TurnoverRiskAnalysis {
  id              String   @id @default(cuid())
  employeeId      String
  riskScore       Float    // 0-100
  riskLevel       String   // LOW, MEDIUM, HIGH, CRITICAL
  factors         Json     // 위험 요인 분석
  recommendations String[] // 대응 권고사항
  analyzedAt      DateTime @default(now())

  @@index([employeeId])
  @@index([riskLevel])
  @@index([analyzedAt])
}

// 다양성 지표
model DiversityMetrics {
  id              String   @id @default(cuid())
  period          String   // 측정 기간
  organizationId  String?
  metrics         Json     // 성별, 연령, 직급별 분포 등
  genderRatio     Float?   // 성별 비율
  ageDistribution Json?    // 연령대 분포
  positionDiversity Float? // 직급 다양성 지수
  trend           Json?    // 추세 분석
  measuredAt      DateTime @default(now())

  @@index([period])
  @@index([organizationId])
}

// 보상 공정성 분석
model CompensationAnalysis {
  id              String   @id @default(cuid())
  period          String
  organizationId  String?
  avgSalaryByLevel Json    // 직급별 평균 급여
  payGap          Json?    // 성별/연령별 급여 격차
  performancePayRatio Float? // 성과급 비율
  marketComparison Json?   // 시장 대비 분석
  recommendations String[]
  analyzedAt      DateTime @default(now())

  @@index([period])
  @@index([organizationId])
}

// 조직 건강도 지수
model OrganizationHealthIndex {
  id              String   @id @default(cuid())
  organizationId  String?
  period          String
  overallScore    Float    // 0-100
  dimensions      Json     // 세부 지표
  turnoverRate    Float?
  engagementScore Float?
  trainingHours   Float?
  leaveUtilization Float?
  complianceRate  Float?
  trend           String?  // UP, DOWN, STABLE
  calculatedAt    DateTime @default(now())

  @@index([organizationId])
  @@index([period])
}

// ============================================
// PHASE 10: TALENT LIFECYCLE MANAGEMENT
// ============================================

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskCategory {
  EQUIPMENT        // 장비 지급
  SECURITY         // 보안 교육
  ACCOUNT          // 계정 발급
  TRAINING         // 교육
  DOCUMENTATION    // 문서 작성
  INTRODUCTION     // 소개/인사
}

enum OffboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PENDING_APPROVAL
}

// 온보딩 체크리스트 템플릿
model OnboardingTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  targetJobId     String?  // 직무별 템플릿
  targetOrgId     String?  // 조직별 템플릿
  isDefault       Boolean  @default(false)
  tasks           OnboardingTemplateTask[]
  checklists      OnboardingChecklist[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetJobId])
  @@index([targetOrgId])
}

// 온보딩 템플릿 태스크
model OnboardingTemplateTask {
  id              String       @id @default(cuid())
  templateId      String
  template        OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category        TaskCategory
  name            String
  description     String?
  daysFromStart   Int          // 입사일 기준 예정일 (D+N)
  assigneeRole    String?      // 담당자 역할 (HR, IT, Manager 등)
  isRequired      Boolean      @default(true)
  sortOrder       Int          @default(0)

  @@index([templateId])
}

// 직원별 온보딩 체크리스트
model OnboardingChecklist {
  id              String           @id @default(cuid())
  employeeId      String           @unique
  templateId      String?
  template        OnboardingTemplate? @relation(fields: [templateId], references: [id])
  status          OnboardingStatus @default(NOT_STARTED)
  startDate       DateTime
  targetEndDate   DateTime?
  completedDate   DateTime?
  tasks           OnboardingTask[]
  mentorAssignment MentorAssignment?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([startDate])
}

// 온보딩 개별 태스크
model OnboardingTask {
  id              String           @id @default(cuid())
  checklistId     String
  checklist       OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  category        TaskCategory
  name            String
  description     String?
  dueDate         DateTime?
  assigneeId      String?          // 담당자 ID
  assigneeName    String?          // 담당자 이름
  status          OnboardingStatus @default(NOT_STARTED)
  completedAt     DateTime?
  completedBy     String?
  notes           String?
  attachments     Json?            // 첨부파일 목록
  sortOrder       Int              @default(0)

  @@index([checklistId])
  @@index([status])
  @@index([assigneeId])
}

// 멘토 배정
model MentorAssignment {
  id              String   @id @default(cuid())
  checklistId     String   @unique
  checklist       OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  menteeId        String   // 신입 직원
  mentorId        String   // 멘토 직원
  matchScore      Float?   // 매칭 점수 (직무/경력 기반)
  matchReason     String?  // 매칭 근거
  startDate       DateTime
  endDate         DateTime?
  feedback        MentorFeedback[]
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt       DateTime @default(now())

  @@index([menteeId])
  @@index([mentorId])
}

// 멘토링 피드백
model MentorFeedback {
  id              String           @id @default(cuid())
  assignmentId    String
  assignment      MentorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromType        String           // MENTOR or MENTEE
  rating          Int              // 1-5
  feedback        String?
  createdAt       DateTime         @default(now())

  @@index([assignmentId])
}

// 오프보딩 체크리스트
model OffboardingChecklist {
  id              String             @id @default(cuid())
  employeeId      String             @unique
  status          OffboardingStatus  @default(NOT_STARTED)
  lastWorkingDate DateTime
  reason          String?            // 퇴사 사유
  tasks           OffboardingTask[]
  knowledgeTransfers KnowledgeTransfer[]
  exitInterview   ExitInterview?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([lastWorkingDate])
}

// 오프보딩 태스크
model OffboardingTask {
  id              String              @id @default(cuid())
  checklistId     String
  checklist       OffboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  category        String              // EQUIPMENT_RETURN, ACCESS_REVOKE, HANDOVER, DOCUMENTATION
  name            String
  description     String?
  dueDate         DateTime?
  assigneeId      String?
  status          OffboardingStatus   @default(NOT_STARTED)
  completedAt     DateTime?
  completedBy     String?
  notes           String?
  sortOrder       Int                 @default(0)

  @@index([checklistId])
  @@index([status])
}

// 지식 인수인계
model KnowledgeTransfer {
  id              String   @id @default(cuid())
  checklistId     String
  checklist       OffboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title           String
  description     String?  @db.Text
  content         String   @db.Text    // 인수인계 문서 내용
  recipientId     String              // 인수자
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  attachments     Json?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([checklistId])
  @@index([recipientId])
}

// 퇴직 인터뷰
model ExitInterview {
  id              String   @id @default(cuid())
  checklistId     String   @unique
  checklist       OffboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  interviewerId   String
  scheduledDate   DateTime?
  conductedDate   DateTime?
  responses       Json?    // 인터뷰 응답
  overallSatisfaction Int? // 1-5
  wouldRecommend  Boolean?
  improvementSuggestions String? @db.Text
  confidentialNotes String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// PHASE 11: SKILL GRAPH MANAGEMENT
// ============================================

enum SkillCategory {
  TECHNICAL         // 기술 역량
  BUSINESS          // 업무 역량
  SOFT_SKILL        // 소프트 스킬
  LEADERSHIP        // 리더십
  DOMAIN            // 도메인 지식
  CERTIFICATION     // 자격증/인증
}

enum SkillLevel {
  NOVICE            // 초급 (1)
  BEGINNER          // 입문 (2)
  INTERMEDIATE      // 중급 (3)
  ADVANCED          // 고급 (4)
  EXPERT            // 전문가 (5)
}

enum AssessmentType {
  SELF              // 자기 평가
  MANAGER           // 관리자 평가
  PEER              // 동료 평가
  CERTIFICATION     // 자격증 취득
  PROJECT           // 프로젝트 수행
  TRAINING          // 교육 이수
}

// 스킬 사전 (표준 스킬 정의)
model SkillTaxonomy {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  nameEn          String?       // 영문명
  category        SkillCategory
  description     String?
  parentId        String?       // 상위 스킬
  parent          SkillTaxonomy? @relation("SkillHierarchy", fields: [parentId], references: [id])
  children        SkillTaxonomy[] @relation("SkillHierarchy")
  keywords        String[]      // 검색 키워드
  isActive        Boolean       @default(true)
  employeeSkills  EmployeeSkill[]
  jobRequirements JobRequiredSkill[]
  projectSkills   ProjectRequiredSkill[]
  relatedCourses  CourseSkill[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([category])
  @@index([parentId])
}

// 직원별 스킬 맵
model EmployeeSkill {
  id              String        @id @default(cuid())
  employeeId      String
  skillId         String
  skill           SkillTaxonomy @relation(fields: [skillId], references: [id])
  currentLevel    SkillLevel
  targetLevel     SkillLevel?   // 목표 레벨
  yearsExperience Float?        // 경력 년수
  lastAssessed    DateTime      @default(now())
  assessments     SkillAssessment[]
  endorsements    SkillEndorsement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@index([skillId])
  @@index([currentLevel])
}

// 스킬 평가 이력
model SkillAssessment {
  id              String         @id @default(cuid())
  employeeSkillId String
  employeeSkill   EmployeeSkill  @relation(fields: [employeeSkillId], references: [id], onDelete: Cascade)
  assessmentType  AssessmentType
  previousLevel   SkillLevel?
  assessedLevel   SkillLevel
  assessorId      String?        // 평가자
  evidence        String?        // 근거 URL 또는 설명
  notes           String?
  assessedAt      DateTime       @default(now())

  @@index([employeeSkillId])
  @@index([assessedAt])
}

// 스킬 보증 (동료 추천)
model SkillEndorsement {
  id              String        @id @default(cuid())
  employeeSkillId String
  employeeSkill   EmployeeSkill @relation(fields: [employeeSkillId], references: [id], onDelete: Cascade)
  endorserId      String
  relationship    String        // 동료, 협업자, 관리자 등
  comment         String?
  endorsedAt      DateTime      @default(now())

  @@unique([employeeSkillId, endorserId])
  @@index([employeeSkillId])
}

// 직무별 필수 스킬
model JobRequiredSkill {
  id              String        @id @default(cuid())
  jobId           String
  skillId         String
  skill           SkillTaxonomy @relation(fields: [skillId], references: [id])
  requiredLevel   SkillLevel
  importance      String        @default("REQUIRED") // REQUIRED, PREFERRED, NICE_TO_HAVE
  weight          Float         @default(1.0)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

// 스킬 갭 분석
model SkillGapAnalysis {
  id              String   @id @default(cuid())
  employeeId      String
  jobId           String   // 비교 대상 직무
  analysisDate    DateTime @default(now())
  overallGapScore Float    // 전체 갭 점수 (0-100, 낮을수록 좋음)
  skillGaps       Json     // 스킬별 갭 상세
  recommendations Json?    // 추천 교육/경험
  priority        String   @default("MEDIUM") // HIGH, MEDIUM, LOW

  @@index([employeeId])
  @@index([jobId])
  @@index([analysisDate])
}

// 프로젝트 필요 스킬
model ProjectRequiredSkill {
  id              String        @id @default(cuid())
  projectId       String        // 내부 프로젝트 ID
  skillId         String
  skill           SkillTaxonomy @relation(fields: [skillId], references: [id])
  requiredLevel   SkillLevel
  headcount       Int           @default(1)

  @@unique([projectId, skillId])
  @@index([projectId])
}

// 교육 과정-스킬 매핑
model CourseSkill {
  id              String        @id @default(cuid())
  courseId        String
  skillId         String
  skill           SkillTaxonomy @relation(fields: [skillId], references: [id])
  targetLevel     SkillLevel    // 이수 후 도달 가능 레벨

  @@unique([courseId, skillId])
  @@index([courseId])
}

// 프로젝트 인력 추천
model StaffingRecommendation {
  id              String   @id @default(cuid())
  projectId       String
  employeeId      String
  matchScore      Float    // 0-100
  matchDetails    Json     // 스킬별 매칭 상세
  availability    String?  // 가용성 상태
  status          String   @default("RECOMMENDED") // RECOMMENDED, ASSIGNED, DECLINED
  recommendedAt   DateTime @default(now())

  @@index([projectId])
  @@index([employeeId])
  @@index([matchScore])
}

// ============================================
// PHASE 12: INTERNAL TALENT MARKETPLACE
// ============================================

enum OpportunityType {
  FULL_TIME         // 정규 포지션
  PROJECT           // 프로젝트 참여
  TASK_FORCE        // TF 운영
  PILOT             // 파일럿 프로그램
  SECONDMENT        // 파견
  ROTATION          // 순환 근무
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
  CANCELLED
}

enum InternalAppStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  SELECTED
  NOT_SELECTED
  WITHDRAWN
}

// 내부 공모 (포지션/프로젝트)
model InternalOpportunity {
  id              String            @id @default(cuid())
  type            OpportunityType
  title           String
  description     String            @db.Text
  organizationId  String
  positionId      String?
  jobId           String?
  requiredSkills  Json              // 필요 스킬 및 레벨
  preferredSkills Json?             // 우대 스킬
  requirements    Json?             // 기타 요구사항
  duration        String?           // 기간 (프로젝트의 경우)
  hoursPerWeek    Int?              // 주당 시간 (겸직의 경우)
  location        String?
  benefits        String?           @db.Text
  openings        Int               @default(1)
  filledCount     Int               @default(0)
  status          OpportunityStatus @default(DRAFT)
  publishedAt     DateTime?
  closingDate     DateTime?
  applications    InternalApplication[]
  matches         OpportunityMatch[]
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([organizationId])
  @@index([closingDate])
}

// 내부 지원서
model InternalApplication {
  id              String                @id @default(cuid())
  opportunityId   String
  opportunity     InternalOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId     String                // 지원자 직원 ID
  status          InternalAppStatus     @default(APPLIED)
  coverLetter     String?               @db.Text
  skillMatch      Json?                 // 스킬 매칭 분석 결과
  matchScore      Float?                // 매칭 점수
  managerApproval Boolean               @default(false) // 현재 소속 관리자 승인
  interviews      InternalInterview[]
  notes           String?
  appliedAt       DateTime              @default(now())
  decidedAt       DateTime?
  decisionBy      String?
  decisionReason  String?

  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
  @@index([status])
}

// 내부 면접
model InternalInterview {
  id              String              @id @default(cuid())
  applicationId   String
  application     InternalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId   String
  scheduledAt     DateTime
  completedAt     DateTime?
  rating          Int?                // 1-5
  feedback        String?             @db.Text
  recommendation  String?             // HIRE, NO_HIRE, MAYBE

  @@index([applicationId])
  @@index([interviewerId])
}

// 자동 매칭 결과
model OpportunityMatch {
  id              String              @id @default(cuid())
  opportunityId   String
  opportunity     InternalOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employeeId      String
  matchScore      Float               // 0-100
  matchBreakdown  Json                // 스킬별 매칭 상세
  isNotified      Boolean             @default(false) // 직원에게 알림 발송 여부
  matchedAt       DateTime            @default(now())

  @@unique([opportunityId, employeeId])
  @@index([opportunityId])
  @@index([employeeId])
  @@index([matchScore])
}

// 경력 이동 이력
model CareerMovement {
  id              String   @id @default(cuid())
  employeeId      String
  movementType    String   // TRANSFER, PROJECT, SECONDMENT, ROTATION
  fromOrgId       String
  toOrgId         String
  fromJobId       String?
  toJobId         String?
  opportunityId   String?  // 관련 내부 공모
  startDate       DateTime
  endDate         DateTime?
  isPermanent     Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([employeeId])
  @@index([fromOrgId])
  @@index([toOrgId])
  @@index([startDate])
}

// ============================================
// PHASE 13: AI DECISION SUPPORT
// ============================================

enum RecommendationType {
  PROMOTION
  SALARY_ADJUSTMENT
  PERFORMANCE_INTERVENTION
  DEVELOPMENT_PLAN
  TEAM_RESTRUCTURE
  RETENTION_ACTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SignalType {
  ENGAGEMENT_DROP      // 참여도 하락
  PERFORMANCE_DECLINE  // 성과 하락
  ABSENCE_PATTERN      // 결근 패턴
  OVERTIME_EXCESS      // 과도한 초과근무
  TRAINING_SKIP        // 교육 미이수
  PEER_CONFLICT        // 동료 갈등
  COMPENSATION_GAP     // 보상 격차
  CAREER_STALL         // 경력 정체
}

// 승진 추천
model PromotionRecommendation {
  id              String   @id @default(cuid())
  employeeId      String
  currentPositionId String
  recommendedPositionId String
  confidenceScore Float    // 0-100
  factorAnalysis  Json     // 분석 요인 상세
  performanceScore Float?
  tenureMonths    Int?
  skillReadiness  Float?   // 스킬 준비도
  leadershipScore Float?
  comparativePlacement Json? // 동기 대비 위치
  recommendation  String   // STRONG_RECOMMEND, RECOMMEND, HOLD, NOT_READY
  explanation     String   @db.Text  // 설명 가능한 근거
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  generatedAt     DateTime @default(now())

  @@index([employeeId])
  @@index([recommendation])
  @@index([generatedAt])
}

// 보상 시뮬레이션
model CompensationSimulation {
  id              String   @id @default(cuid())
  simulationType  String   // INDIVIDUAL, TEAM, ORGANIZATION
  targetId        String   // 대상 ID (직원/팀/조직)
  currentCompensation Json
  proposedCompensation Json
  marketComparison Json    // 시장 대비 분석
  equityAnalysis  Json     // 공정성 분석
  budgetImpact    Json     // 예산 영향
  riskAssessment  Json?    // 리스크 평가
  alternativeScenarios Json? // 대안 시나리오
  fairnessScore   Float    // 공정성 점수 (0-100)
  explanation     String   @db.Text
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([simulationType])
  @@index([targetId])
}

// 이탈 시그널
model AttritionSignal {
  id              String     @id @default(cuid())
  employeeId      String
  signalType      SignalType
  signalStrength  Float      // 0-100 (강도)
  detectedAt      DateTime   @default(now())
  dataPoints      Json       // 근거 데이터
  trend           String?    // INCREASING, STABLE, DECREASING
  isAcknowledged  Boolean    @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  actionTaken     String?
  expiresAt       DateTime?  // 시그널 만료 시점

  @@index([employeeId])
  @@index([signalType])
  @@index([detectedAt])
  @@index([signalStrength])
}

// 조직/팀 리스크
model TeamRiskIndicator {
  id              String    @id @default(cuid())
  organizationId  String
  riskType        String    // ATTRITION_CLUSTER, PERFORMANCE_DECLINE, OVERWORK, CONFLICT
  riskLevel       RiskLevel
  riskScore       Float     // 0-100
  affectedEmployees Json    // 영향 받는 직원 목록
  indicators      Json      // 리스크 지표 상세
  suggestedActions Json     // 권고 조치
  explanation     String    @db.Text
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolution      String?

  @@index([organizationId])
  @@index([riskType])
  @@index([riskLevel])
  @@index([detectedAt])
}

// AI 판단 설명
model AIDecisionExplanation {
  id              String   @id @default(cuid())
  decisionType    RecommendationType
  relatedEntityId String   // 관련 추천/분석 ID
  modelVersion    String
  inputFeatures   Json     // 입력 특성
  featureImportance Json   // 특성 중요도
  decisionPath    Json     // 결정 경로 (트리 기반)
  counterfactuals Json?    // 반사실적 설명 (무엇이 달랐다면...)
  confidenceBreakdown Json // 신뢰도 상세
  biasCheck       Json?    // 편향 검사 결과
  humanReadable   String   @db.Text  // 사람이 읽기 쉬운 설명
  createdAt       DateTime @default(now())

  @@index([decisionType])
  @@index([relatedEntityId])
  @@index([createdAt])
}

// AI 모델 버전 관리
model AIModelRegistry {
  id              String   @id @default(cuid())
  modelName       String
  version         String
  purpose         String   // 용도 설명
  algorithm       String   // 알고리즘 유형
  trainingData    Json     // 학습 데이터 정보
  performanceMetrics Json  // 성능 지표
  isActive        Boolean  @default(true)
  deployedAt      DateTime @default(now())
  retiredAt       DateTime?

  @@unique([modelName, version])
  @@index([modelName])
  @@index([isActive])
}

// ============================================
// PHASE 14: AUDIT & DISPUTE RESOLUTION
// ============================================

enum DisputeStatus {
  REPORTED
  INVESTIGATING
  MEDIATION
  RESOLUTION
  CLOSED
  ESCALATED
}

enum EvidenceType {
  DOCUMENT
  EMAIL_THREAD
  SYSTEM_LOG
  SCREENSHOT
  TESTIMONY
  POLICY_REFERENCE
  TIMELINE
}

// HR 결정 로그 (자동 기록)
model HRDecisionLog {
  id              String   @id @default(cuid())
  decisionType    String   // HIRE, FIRE, PROMOTE, COMPENSATE, DISCIPLINE, TRANSFER
  relatedEntityType String // Employee, Salary, Appointment 등
  relatedEntityId String
  decisionMaker   String   // 결정자 ID
  decisionMakerRole String // 결정자 역할
  decision        String   // 결정 내용
  reasoning       String?  @db.Text  // 결정 근거
  supportingData  Json     // 지원 데이터
  policyReference String?  // 참조 정책
  approvalChain   Json?    // 승인 결재선
  effectiveDate   DateTime
  systemContext   Json     // 시스템 컨텍스트 (IP, 세션 등)
  createdAt       DateTime @default(now())

  @@index([decisionType])
  @@index([relatedEntityType, relatedEntityId])
  @@index([decisionMaker])
  @@index([effectiveDate])
  @@index([createdAt])
}

// 분쟁/이슈 케이스
model DisputeCase {
  id              String        @id @default(cuid())
  caseNumber      String        @unique
  title           String
  description     String        @db.Text
  category        String        // DISCRIMINATION, HARASSMENT, WRONGFUL_TERMINATION, COMPENSATION, OTHER
  reporterId      String?       // 신고자 (익명 가능)
  isAnonymous     Boolean       @default(false)
  involvedParties Json          // 관련자 목록
  status          DisputeStatus @default(REPORTED)
  priority        String        @default("MEDIUM")
  assignedTo      String?       // 담당자
  timeline        DisputeTimelineEvent[]
  evidences       EvidenceItem[]
  resolution      String?       @db.Text
  resolutionDate  DateTime?
  legalReviewRequired Boolean   @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
}

// 분쟁 타임라인 이벤트
model DisputeTimelineEvent {
  id              String      @id @default(cuid())
  caseId          String
  case            DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventDate       DateTime
  eventType       String      // REPORTED, ASSIGNED, INVESTIGATION, MEETING, EVIDENCE_ADDED, STATUS_CHANGE, RESOLUTION
  title           String
  description     String?     @db.Text
  actorId         String?
  isPrivate       Boolean     @default(false) // 법무팀만 볼 수 있는 이벤트
  attachments     Json?
  createdAt       DateTime    @default(now())

  @@index([caseId])
  @@index([eventDate])
}

// 증거 자료
model EvidenceItem {
  id              String       @id @default(cuid())
  caseId          String
  case            DisputeCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            EvidenceType
  title           String
  description     String?
  content         String?      @db.Text  // 텍스트 증거
  fileUrl         String?      // 파일 증거
  sourceSystem    String?      // 출처 시스템
  originalTimestamp DateTime?  // 원본 타임스탬프
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, DISPUTED
  addedBy         String
  addedAt         DateTime     @default(now())

  @@index([caseId])
  @@index([type])
}

// 감사 증빙 패키지
model EvidencePackage {
  id              String   @id @default(cuid())
  name            String
  purpose         String   // AUDIT, LEGAL_REVIEW, EXTERNAL_SUBMISSION
  relatedCaseId   String?
  requestedBy     String
  requestedFor    String?  // 감사 기관/법무 담당자
  dateRange       Json?    // 대상 기간
  includesEntities Json    // 포함된 엔티티 목록
  generatedFiles  Json     // 생성된 파일 목록
  checksum        String?  // 무결성 검증용
  expiresAt       DateTime?
  downloadCount   Int      @default(0)
  lastDownloadAt  DateTime?
  createdAt       DateTime @default(now())

  @@index([purpose])
  @@index([relatedCaseId])
}

// 과거 권한 상태 스냅샷
model AccessStateSnapshot {
  id              String   @id @default(cuid())
  userId          String
  snapshotDate    DateTime
  roles           Json     // 역할 목록
  permissions     Json     // 권한 목록
  organizationAccess Json  // 조직 접근 권한
  dataAccessLevels Json    // 데이터 접근 수준
  activeSession   Json?    // 활성 세션 정보
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([snapshotDate])
}

// 법무팀 전용 뷰 접근
model LegalTeamAccess {
  id              String   @id @default(cuid())
  userId          String   @unique
  accessLevel     String   // VIEW_ONLY, FULL_ACCESS
  accessibleCases String[] // 접근 가능 케이스 ID (빈 배열 = 전체)
  grantedBy       String
  grantedAt       DateTime @default(now())
  expiresAt       DateTime?
  isActive        Boolean  @default(true)

  @@index([userId])
  @@index([isActive])
}

// ============================================
// PHASE 15: BATCH PROCESSING & SEARCH
// ============================================

enum BatchJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BatchJobType {
  SALARY_CALCULATION    // 급여 일괄 계산
  LEAVE_GRANT          // 연차 일괄 부여
  EVALUATION_INIT      // 평가 일괄 생성
  DATA_SYNC            // 데이터 동기화
  REPORT_GENERATION    // 리포트 생성
  INDEX_UPDATE         // 인덱스 갱신
  NOTIFICATION_SEND    // 알림 일괄 발송
}

// 배치 작업
model BatchJob {
  id              String         @id @default(cuid())
  type            BatchJobType
  name            String
  description     String?
  parameters      Json           // 작업 파라미터
  targetCount     Int?           // 대상 건수
  processedCount  Int            @default(0)
  successCount    Int            @default(0)
  failedCount     Int            @default(0)
  status          BatchJobStatus @default(PENDING)
  priority        Int            @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  result          Json?          // 작업 결과
  createdBy       String
  createdAt       DateTime       @default(now())
  logs            BatchJobLog[]

  @@index([type])
  @@index([status])
  @@index([scheduledAt])
}

// 배치 작업 로그
model BatchJobLog {
  id              String    @id @default(cuid())
  jobId           String
  job             BatchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level           String    // INFO, WARN, ERROR
  message         String
  recordId        String?   // 처리된 레코드 ID
  details         Json?
  createdAt       DateTime  @default(now())

  @@index([jobId])
  @@index([level])
}

// 검색 인덱스 메타
model SearchIndex {
  id              String   @id @default(cuid())
  indexName       String   @unique
  entityType      String   // 인덱싱 대상 엔티티
  lastUpdatedAt   DateTime
  documentCount   Int
  indexStatus     String   // READY, UPDATING, ERROR
  settings        Json?    // 인덱스 설정
  createdAt       DateTime @default(now())
}

// 검색 쿼리 로그
model SearchQueryLog {
  id              String   @id @default(cuid())
  userId          String
  query           String
  filters         Json?
  resultCount     Int
  responseTimeMs  Int
  clickedResults  String[] // 클릭한 결과 ID
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// PHASE 16: ADVANCED SECURITY & PRIVACY
// ============================================

enum DataZoneType {
  GENERAL           // 일반
  CONFIDENTIAL      // 기밀
  SENSITIVE         // 민감
  RESTRICTED        // 제한
}

enum VerificationLevel {
  BASIC             // 기본 인증
  MFA               // 다중 인증
  BIOMETRIC         // 생체 인증
  SUPERVISOR        // 상급자 승인
}

// 데이터 존 정의
model DataZone {
  id              String       @id @default(cuid())
  name            String       @unique
  type            DataZoneType
  description     String?
  encryptionRequired Boolean   @default(false)
  accessPolicies  Json         // 접근 정책
  retentionDays   Int?         // 보관 기간
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// 프라이버시 존 (AI 분석용 익명 영역)
model PrivacyZone {
  id              String   @id @default(cuid())
  name            String
  description     String?
  anonymizationRules Json   // 익명화 규칙
  allowedAnalytics String[] // 허용된 분석 유형
  accessLog       PrivacyZoneAccessLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 프라이버시 존 접근 로그
model PrivacyZoneAccessLog {
  id              String      @id @default(cuid())
  zoneId          String
  zone            PrivacyZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  userId          String
  purpose         String      // 접근 목적
  queryDetails    Json?       // 쿼리 상세
  resultCount     Int?
  accessedAt      DateTime    @default(now())

  @@index([zoneId])
  @@index([userId])
  @@index([accessedAt])
}

// Zero Trust 검증 기록
model ZeroTrustVerification {
  id              String            @id @default(cuid())
  userId          String
  sessionId       String
  resourceType    String            // 접근 리소스 유형
  resourceId      String?
  requiredLevel   VerificationLevel
  actualLevel     VerificationLevel
  passed          Boolean
  factors         Json              // 검증 요소
  riskScore       Float?            // 리스크 점수
  deviceFingerprint String?
  ipAddress       String
  geoLocation     String?
  verifiedAt      DateTime          @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([passed])
  @@index([verifiedAt])
}

// 이상 행위 탐지
model AnomalyDetection {
  id              String   @id @default(cuid())
  userId          String
  anomalyType     String   // LOGIN_PATTERN, ACCESS_PATTERN, DATA_EXPORT, TIME_ANOMALY
  severity        String   // LOW, MEDIUM, HIGH, CRITICAL
  description     String
  detectedPattern Json     // 감지된 패턴
  baselinePattern Json     // 기준 패턴
  deviation       Float    // 이탈 정도
  isBlocked       Boolean  @default(false)
  isReviewed      Boolean  @default(false)
  reviewedBy      String?
  reviewResult    String?
  detectedAt      DateTime @default(now())

  @@index([userId])
  @@index([anomalyType])
  @@index([severity])
  @@index([isReviewed])
}

// 보안 정책
model SecurityPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  category        String   // ACCESS, DATA, NETWORK, DEVICE
  rules           Json     // 정책 규칙
  enforcement     String   // ENFORCE, AUDIT_ONLY
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// PHASE 17: HR DATA LAKE & ANALYTICS
// ============================================

enum EventClassification {
  EMPLOYMENT       // 고용 이벤트
  COMPENSATION     // 보상 이벤트
  PERFORMANCE      // 성과 이벤트
  ATTENDANCE       // 근태 이벤트
  TRAINING         // 교육 이벤트
  ORGANIZATION     // 조직 이벤트
}

// HR 이벤트 스트림
model HREvent {
  id              String              @id @default(cuid())
  eventType       String              // 세부 이벤트 유형
  classification  EventClassification
  entityType      String              // User, Employee, Department 등
  entityId        String
  eventPayload    Json                // 이벤트 데이터
  metadata        Json?               // 메타데이터
  sourceSystem    String              // 이벤트 출처
  occurredAt      DateTime            // 실제 발생 시점
  processedAt     DateTime            @default(now())

  @@index([eventType])
  @@index([classification])
  @@index([entityType, entityId])
  @@index([occurredAt])
}

// 데이터 레이크 원천 테이블
model DataLakeRecord {
  id              String   @id @default(cuid())
  sourceTable     String   // 원천 테이블명
  recordId        String   // 원천 레코드 ID
  data            Json     // 스키마 변환된 데이터
  partition       String   // 파티션 키 (YYYYMM)
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  ingestedAt      DateTime @default(now())

  @@index([sourceTable, recordId])
  @@index([partition])
  @@index([isLatest])
}

// 시계열 분석 결과
model TimeSeriesAnalysis {
  id              String   @id @default(cuid())
  metricName      String   // turnover_rate, headcount, avg_salary 등
  organizationId  String?
  timePeriod      String   // DAILY, WEEKLY, MONTHLY, QUARTERLY
  periodValue     String   // 2024-01, 2024-Q1 등
  value           Float
  previousValue   Float?
  changePercent   Float?
  trend           String?  // UP, DOWN, STABLE
  seasonality     Json?    // 계절성 분석
  forecast        Float?   // 예측값
  confidence      Float?   // 예측 신뢰도
  calculatedAt    DateTime @default(now())

  @@unique([metricName, organizationId, timePeriod, periodValue])
  @@index([metricName])
  @@index([organizationId])
  @@index([periodValue])
}

// 외부 데이터 연결
model ExternalDataLink {
  id              String   @id @default(cuid())
  name            String
  sourceType      String   // SALES, FINANCE, OKR, SURVEY
  connectionConfig Json    // 연결 설정 (암호화)
  syncFrequency   String   // REALTIME, HOURLY, DAILY
  lastSyncAt      DateTime?
  syncStatus      String   // SUCCESS, FAILED, PENDING
  mappingRules    Json     // 데이터 매핑 규칙
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceType])
  @@index([isActive])
}

// 장기 트렌드 리포트
model LongTermTrendReport {
  id              String   @id @default(cuid())
  reportName      String
  description     String?
  timeSpan        String   // 분석 기간 (예: "5Y", "3Y")
  startDate       DateTime
  endDate         DateTime
  metrics         Json     // 분석 대상 지표
  findings        Json     // 주요 발견사항
  visualizations  Json?    // 시각화 데이터
  recommendations String[] // 권고사항
  generatedBy     String
  generatedAt     DateTime @default(now())

  @@index([reportName])
  @@index([startDate])
}

// 코호트 분석
model CohortAnalysis {
  id              String   @id @default(cuid())
  cohortType      String   // HIRE_MONTH, DEPARTMENT, POSITION
  cohortValue     String   // 2024-01, Engineering 등
  analysisType    String   // RETENTION, PROMOTION, PERFORMANCE
  timeUnit        String   // MONTH, QUARTER, YEAR
  data            Json     // 코호트 분석 데이터
  metrics         Json     // 주요 지표
  comparisons     Json?    // 비교 분석
  analyzedAt      DateTime @default(now())

  @@index([cohortType, cohortValue])
  @@index([analysisType])
}
